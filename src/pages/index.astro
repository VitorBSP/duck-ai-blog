---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import ProjectBadge from '../components/ProjectBadge.astro';
import MainLayout from '../layouts/MainLayout.astro';
import {
	BRAND_HANDLE_LABEL,
	PHASE1_PROJECTS,
	SITE_DESCRIPTION,
	SITE_TAGLINE,
	SITE_TITLE,
} from '../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const liveProducts = [PHASE1_PROJECTS['ainda-da'], PHASE1_PROJECTS['radar-eleitoral']];
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="container hero-grid">
			<div>
				<p class="eyebrow">{BRAND_HANDLE_LABEL}</p>
				<h1 class="hero-title">{SITE_TAGLINE}</h1>
				<p class="hero-lead">
					Construindo em público ferramentas orientadas por dados — das probabilidades no futebol do{' '}
					<strong>Ainda Dá</strong> à transparência estatística do <strong>Radar Eleitoral</strong> —
					com engenharia enxuta e rigor metodológico.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="/blog">Ler artigos recentes</a>
					<a class="btn btn-secondary" href="/projetos">Explorar projetos</a>
				</div>
			</div>

			<aside class="hero-aside" aria-label="Produtos ativos na Fase 1">
				<p class="aside-label">Produtos no ar · Fase 1</p>
				<ul class="active-project-list">
					{
						liveProducts.map((proj) => (
							<li class="active-project-row">
								<div>
									<a
										class="active-project-name"
										href={proj.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										{proj.name}
									</a>
									<p class="active-project-desc">{proj.tagline}</p>
								</div>
								<a
									class="active-project-link"
									href={proj.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									Abrir ↗
								</a>
							</li>
						))
					}
				</ul>
			</aside>
		</div>
	</section>

	<section class="section" aria-labelledby="latest-articles-heading">
		<div class="container">
			<div class="section-header">
				<div>
					<h2 id="latest-articles-heading" class="section-title">Publicações Recentes</h2>
					<p class="section-subtitle">
						Estudos técnicos, bastidores de produto e análises com fontes verificáveis.
					</p>
				</div>

				<div class="filter-bar" role="group" aria-label="Filtrar artigos por projeto">
					<button class="filter-btn is-active" type="button" data-filter="all">Todos</button>
					<button class="filter-btn" type="button" data-filter="blog-central">Duck AI</button>
					<button class="filter-btn" type="button" data-filter="ainda-da">Ainda Dá</button>
					<button class="filter-btn" type="button" data-filter="radar-eleitoral">
						Radar Eleitoral
					</button>
				</div>
			</div>

			<div id="home-post-grid" class="post-grid">
				{
					posts.map((post) => (
						<article class="post-card" data-project={post.data.project}>
							<div>
								<div class="post-card-meta">
									<ProjectBadge project={post.data.project} />
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="post-card-title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p class="post-card-desc">{post.data.description}</p>
							</div>
							<div class="post-card-footer">
								<span>{post.data.readingTimeMinutes} min de leitura</span>
								<a class="read-more" href={`/blog/${post.id}/`}>
									Ler artigo →
								</a>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-bordered">
		<div class="container">
			<NewsletterBox idPrefix="home-nl" />
		</div>
	</section>
</MainLayout>

<script is:inline>
	(() => {
		const buttons = document.querySelectorAll('.filter-btn[data-filter]');
		const cards = document.querySelectorAll('#home-post-grid .post-card');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const filter = btn.dataset.filter;
				buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
				cards.forEach((card) => {
					const show = filter === 'all' || card.dataset.project === filter;
					card.style.display = show ? 'flex' : 'none';
				});
			});
		});
	})();
</script>
